@model List<productcatalog.Models.Product>
@{
    ViewBag.Title = "Index";
}

@{
    Layout = null;
}
<h2>Product catalog (92400120484 Naveen)</h2>
<table border="1">
    <tr>
        <th>Product ID</th>
        <th>Product Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Category</th>
        <th>Action</th>
    </tr>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.ProductId</td>
            <td>@product.ProductName</td>
            <td>@product.Description</td>
            <td>@product.Price</td>
            <td>@product.Category</td>
            <td>
                @Html.ActionLink("view Details", "Details", "product", new { id = product.ProductId }, null) |
            </td>
        </tr>
    }
</table>
